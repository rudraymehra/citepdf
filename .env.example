# Required: Anthropic API key for Claude (generation + Citations API + LLM-judge)
ANTHROPIC_API_KEY=sk-ant-...

# Models — Sonnet 4.6 default for generation (3-5x faster than Opus, marginally lower
# quality, still excellent). Haiku 4.5 for the cheap many-call paths (standalone rewrite,
# faithfulness judge, contextual headers, deep-mode query transforms, RAPTOR summaries).
# To upgrade for max quality: ANTHROPIC_GENERATION_MODEL=claude-opus-4-7
ANTHROPIC_GENERATION_MODEL=claude-sonnet-4-6
ANTHROPIC_JUDGE_MODEL=claude-haiku-4-5

# Qdrant (the docker-compose qdrant service exposes 6333)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Redis (used by the arq async ingestion worker)
REDIS_URL=redis://localhost:6379

# Where to cache HF models (BGE-M3, bge-reranker-v2-m3) — first run downloads ~1.8GB
HF_HOME=./.cache/huggingface

# API + frontend
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
STREAMLIT_PORT=8501

# Storage for uploaded PDFs (relative to project root)
DATA_DIR=./eval/data

# Retrieval thresholds
# 20 is a sweet spot for Mac CPU: large enough for hybrid recall, small enough
# that bge-reranker-v2-m3 runs in ~1-2s. Bump back to 50 if you're on a real GPU.
TOPK_PREFETCH=20
TOPK_FINAL=8
OOS_CENTROID_THRESHOLD=0.20
OOS_TOP1_THRESHOLD=0.10
FAITHFULNESS_THRESHOLD=0.85

# Refusal string (must match exactly across the system)
REFUSAL_STRING=I cannot answer this from the provided document.

# Chainlit persistent thread storage (ChatGPT-style sidebar with all past chats)
# SQLite locally; for HF Spaces persistent storage point at /data/chainlit.db.
# Set to "" to disable persistence (in-memory threads only).
CHAINLIT_DB_URL=sqlite+aiosqlite:///./data/chainlit.db
# Required by Chainlit when persistence is on. Generate with:  openssl rand -hex 32
CHAINLIT_AUTH_SECRET=change-me-to-a-random-32-byte-hex-string

# Phase 2 toggles
ENABLE_CONTEXTUAL_HEADERS=true
ENABLE_RAPTOR=true
RAPTOR_MAX_LEVELS=3
DEEP_MODE_MULTIQUERY_N=3
